<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ request.locale.text_layout_direction }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#FFFFFF">

  <title>
    {%- if page_title -%}{{ page_title }}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    {%- else -%}{{ shop.name }}
    {%- endif -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <link rel="icon" type="image/jpeg" href="{{ 'logo.jpeg' | asset_url }}">
  <link rel="apple-touch-icon" href="{{ 'logo.jpeg' | asset_url }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700;800&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}

  {%- style -%}
    :root {
      --space: {{ settings.color_space }};
      --deep-blue: {{ settings.color_deep_blue }};
      --cyan: {{ settings.color_cyan }};
      --violet: {{ settings.color_violet }};
      --pink: {{ settings.color_pink }};
      --white: {{ settings.color_white }};
      --muted: {{ settings.color_muted }};
    }
  {%- endstyle -%}
</head>

<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
  <a class="skip-link" href="#main-content">{{ 'general.skip_to_content' | t | default: 'Skip to content' }}</a>

  {% sections 'header-group' %}

  <main id="main-content" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% section 'cart-drawer' %}
  {% section 'predictive-search' %}

  {% render 'particles' %}
  {% render 'scroll-animations' %}
  {% render 'back-to-top' %}
  {% render 'chat-bot' %}

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
